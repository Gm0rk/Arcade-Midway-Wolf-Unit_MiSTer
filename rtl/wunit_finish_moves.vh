// the OSD's character lists (alphabetical) to the game's numbers
function automatic [4:0] opt_char(input u, input [4:0] o);
	case ({u, o})
		6'h00: opt_char = 5'd8;  // Cyrax
		6'h01: opt_char = 5'd2;  // Jax
		6'h02: opt_char = 5'd10; // Kabal
