		9'h163: idx_q <= 11'd449;  // Shang Tsung, Animality: hold:HP w:66 RN RN RN rel:HP
		9'h166: idx_q <= 11'd39;   // Shang Tsung, Mercy: hold:RN w:66 D D rel:RN
		9'h168: idx_q <= 11'd843;  // Liu Kang, Fatality 1: F F F B F LK
		9'h169: idx_q <= 11'd850;  // Liu Kang, Fatality 2: hold:RN+BL U U U U rel:BL BL rel:RN
		9'h16A: idx_q <= 11'd727;  // Liu Kang, Stage Fatality: F F F RN
		9'h16B: idx_q <= 11'd480;  // Liu Kang, Animality: D D U
		9'h16E: idx_q <= 11'd39;   // Liu Kang, Mercy: hold:RN w:66 D D rel:RN
		9'h173: idx_q <= 11'd859;  // Smoke, Animality: D F F BL
		9'h176: idx_q <= 11'd39;   // Smoke, Mercy: hold:RN w:66 D D rel:RN
		default: idx_q <= 11'd0;
	endcase
end

